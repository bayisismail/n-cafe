JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-admin-password
OPERATOR_PIN=replace-with-a-4-digit-pin
ALLOWED_ORIGIN=https://your-domain.example
DATA_DIR=/var/lib/n-cafe
# Optional PostgreSQL settings:
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_CA=-----BEGIN CERTIFICATE-----...
# Optional Razorpay settings:
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=keep-this-server-side
