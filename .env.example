JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-admin-password
OPERATOR_PIN=replace-with-a-4-digit-pin
ALLOWED_ORIGIN=https://your-domain.example
DATA_DIR=/var/lib/n-cafe
# MongoDB Atlas settings (recommended for hosted deployment):
# MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DATABASE=n_cafe
# Atlas connections require TLS; do not disable certificate validation.
# Legacy PostgreSQL settings:
# DATABASE_URL=postgresql://user:password@host:5432/database
# DATABASE_CA=-----BEGIN CERTIFICATE-----...
# Optional Razorpay settings:
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=keep-this-server-side
